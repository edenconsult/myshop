{
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.97",
    "tailwindcss": "^3.3.2"
  },
  "dependencies": {
    "flowbite": "^1.6.5"
  },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "watch": "node scripts/build-icons.mjs && tailwindcss -i ./static/src/input.css -o ./static/src/output.css --watch",
    "build": "node scripts/build-icons.mjs && tailwindcss -i ./static/src/input.css -o ./static/src/output.css",
    "deploy": "npm run build && python manage.py collectstatic --noinput"
  }
}
